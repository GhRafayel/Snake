# Copy this file to ".env" in the project root and fill in real values.
# ".env" is git-ignored on purpose -- never commit real secrets.

# --- backend / database ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

PORT=4000
FRONTEND_URL=https://localhost
REDIS_URL=redis://redis:6379

# SMTP account used to send password-reset / notification emails
PROJECT_EMAIL="your-project-mailbox@example.com"
EMAIL_PASS="your-smtp-app-password"

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_hex_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed accounts created by "make admin" (npm run seed:admin)
ADMIN_1_USERNAME=admin
ADMIN_1_EMAIL=admin@example.com
ADMIN_1_PASSWORD=change_me
ADMIN_1_LANGUAGE=en

# --- frontend ---
API_PREFIX=api/
NEXT_PUBLIC_API_URL=http://localhost:3000/
NEXT_PUBLIC_WS_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=https://localhost
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_base64_string
NEXTAUTH_URL=http://localhost:2000
INTERNAL_API_URL=http://backend:4000/api
